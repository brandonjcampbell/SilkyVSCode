{
	"name": "silky-vscode",
	"displayName": "Silky",
	"description": "Custom editors for Silky story-graph files (.silky.element/.fact/.snippet/.thread)",
	"version": "0.0.1",
	"publisher": "brandonjcampbell",
	"private": true,
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/brandonjcampbell/SilkyVSCode"
	},
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "silky.element",
				"displayName": "Silky Element",
				"selector": [
					{
						"filenamePattern": "*.silky.element"
					}
				]
			},
						{
				"viewType": "silky.fact",
				"displayName": "Silky Fact",
				"selector": [
					{
						"filenamePattern": "*.silky.fact"
					}
				]
			},
						{
				"viewType": "silky.snippet",
				"displayName": "Silky Snippet",
				"selector": [
					{
						"filenamePattern": "*.silky.snippet"
					}
				]
			},
						{
				"viewType": "silky.thread",
				"displayName": "Silky Thread",
				"selector": [
					{
						"filenamePattern": "*.silky.thread"
					}
				]
			},
			{
				"viewType": "silky.web",
				"displayName": "Silky Web",
				"selector": [
					{
						"filenamePattern": "*.silky.web"
					}
				]
			}
			
		],
		"commands": [
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint \"src/**/*.ts\"",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@types/node": "^16.11.7",
		"@types/vscode": "^1.73.0",
		"@typescript-eslint/eslint-plugin": "^5.42.0",
		"@typescript-eslint/parser": "^5.42.0",
		"eslint": "^8.26.0",
		"typescript": "^4.8.4"
	}
}
